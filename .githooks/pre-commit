#!/usr/bin/env bash
# pre-commit — secret scan gate for dsh-profile-config (public repo).
#
# Enabled via: git config core.hooksPath .githooks
#
# Scope: the STAGED content only (`gitleaks git --staged`), i.e. exactly what
# this commit would publish. Scanning the whole working tree instead would
# flag the intentionally-present, gitignored live files (settings.yaml,
# .credentials.yaml) on every commit and train the user to bypass the gate.
#
# Degradation contract: if gitleaks is NOT installed this hook FAILS LOUDLY
# with install instructions. It does not silently pass — a public repo with a
# permissive scan gate is worse than an inconvenient one.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: running gitleaks (staged content)..."
  # --redact keeps any finding value out of the terminal output.
  exec gitleaks git --staged --redact -c "$ROOT/.gitleaks.toml" --verbose
fi

cat >&2 <<'EOF'
==========================================================================
 ERROR: gitleaks is not installed — the pre-commit secret scan CANNOT run.
 This is a PUBLIC repository; committing an API key here exposes it.

 Install gitleaks, then retry the commit:
   brew install gitleaks        # macOS
   https://github.com/gitleaks/gitleaks#installing

 (Emergency-only bypass, NOT recommended: git commit --no-verify)
==========================================================================
EOF
exit 1
