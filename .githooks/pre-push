#!/usr/bin/env bash
# pre-push — full-history secret scan gate before anything leaves the machine.
#
# Enabled via: git config core.hooksPath .githooks
#
# Primary: gitleaks over the full git history.
# Degradation contract: if gitleaks is missing, fall back to a `git log -p`
# grep over secret indicators AND print a prominent warning that the gitleaks
# gate could not run (so the gap is visible, not silent).

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
fail=0

if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: running gitleaks over full history..."
  gitleaks git --redact -c "$ROOT/.gitleaks.toml" --verbose || fail=1
  exit "$fail"
fi

cat >&2 <<'EOF'
==========================================================================
 WARNING: gitleaks is not installed — the full-history gitleaks gate
 COULD NOT RUN. Falling back to a `git log -p` grep over secret indicators.
 Install gitleaks for the real scan:  brew install gitleaks
==========================================================================
EOF

# Fallback: grep full history patches for secret indicators with a
# non-placeholder value. Lines that are pure placeholder (<REDACTED>) or
# example scaffolding are allowed.
indicators='apikey|api_key|CONTEXT7_API_KEY|ctx7sk|sk-[A-Za-z0-9]'
while IFS= read -r match; do
  # Allow placeholder/example lines.
  case "$match" in
    *"<REDACTED>"*|*"*.example"*) continue ;;
  esac
  echo "POSSIBLE SECRET IN HISTORY: $match" >&2
  fail=1
done < <(git -C "$ROOT" log -p --all 2>/dev/null | grep -Ein "$indicators" || true)

if [ "$fail" -eq 0 ]; then
  echo "pre-push: fallback history grep clean (gitleaks gate DID NOT RUN)." >&2
fi

exit "$fail"
